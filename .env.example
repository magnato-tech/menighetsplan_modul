# Innstillingene til én installasjon av Menighetsplan: én menighet, én database.
#
# På egen maskin: kopier fila til .env.local og fyll inn verdiene fra Firebase-prosjektet
# (Firebase Console, Prosjektinnstillinger, Dine apper, SDK-oppsett og konfigurasjon).
# Der installasjonen publiseres, legges de samme navnene inn som miljøvariabler.
# Ingen av verdiene skrives inn i koden (se src/installation.ts).

# Må være med
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Kan være med
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Bare når databasen har et eget navn. Et nytt prosjekt bruker standarddatabasen, og da står denne tom.
VITE_FIREBASE_DATABASE_ID=
# Leverandørens navn på installasjonen, for eksempel menighetens kortnavn
VITE_TENANT_ID=

# Bare i demoen, aldri hos en menighet. Ordet true gir stripen øverst med nivåvelgeren.
VITE_DEMO=
# Lenkene i stripen: påmeldingen, og nettsiden som presenterer produktet. Uten adresse, ingen lenke.
VITE_DEMO_SIGNUP_URL=
VITE_DEMO_SALES_URL=
# Fingeravtrykket av eierkoden, som åpner «Demo-oppsett» i admin for eieren av demoen. Aldri koden selv.
# Linja lages i demoen: åpne /admin?tab=demo-oppsett og velg en kode.
VITE_DEMO_OWNER_CODE_HASH=
