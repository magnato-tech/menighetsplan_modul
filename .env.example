# Innstillingene til én installasjon av Menighetsplan: én menighet, én database.
#
# På egen maskin: kopier fila til .env.local og fyll inn verdiene fra Firebase-prosjektet
# (Firebase Console, Prosjektinnstillinger, Dine apper, SDK-oppsett og konfigurasjon).
# Der installasjonen publiseres, legges de samme navnene inn som miljøvariabler.
# Ingen av verdiene skrives inn i koden (se src/installation.ts).

# Må være med
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Kan være med
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Bare når databasen har et eget navn. Et nytt prosjekt bruker standarddatabasen, og da står denne tom.
VITE_FIREBASE_DATABASE_ID=
# Leverandørens navn på installasjonen, for eksempel menighetens kortnavn
VITE_TENANT_ID=
