{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/offentlig/kalender.ics",
      "destination": "/api/kalender"
    },
    {
      "source": "/api/kalender-innhold",
      "destination": "/api/kalender-innhold"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
