// Reglene i demoens database, og bare der. Publiseres for hånd i Firebase Console i demoens
// prosjekt (Firestore, Regler). En menighets database får reglene i firestore.rules.
//
// Demoen har ingen innlogging og bare eksempeldata. Alle som ser på den, kan lese og endre alt,
// og databasen fylles på nytt hver natt (scripts/reset-demo.ts). Disse reglene skal aldri
// publiseres i en database med ekte personer.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
