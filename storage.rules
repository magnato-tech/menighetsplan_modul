rules_version = '2';

// The files of the media library. Anyone may read them: they are the pictures on the website.
// Only an administrator or a web editor (nettredaktør) may add, replace or remove one. Who is an administrator is looked up
// where the database rules look it up (see firestore.rules): in `logins`, in the database
// named (default).
//
// Only pictures can be added, and none larger than 20 MB: the files are served to everyone, and
// a page or a script among them would be served too.
//
// The demo's storage is open, and has no rules file of its own.
service firebase.storage {
  match /b/{bucket}/o {
    function writesMedia() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/logins/$(request.auth.token.email.lower()))
        && firestore.get(/databases/(default)/documents/logins/$(request.auth.token.email.lower())).data.role in ['admin', 'nettredaktor'];
    }

    match /media/{mediaId}/{fileName} {
      allow read: if true;
      allow delete: if writesMedia();
      allow create, update: if writesMedia()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
