rules_version = '2';

// The rules of a congregation's own database: closed to everyone who is not in the register,
// except for what the public website shows.
//
// Three kinds of visitors:
//   - anyone: reads the published website, the public events and groups, and the public copies
//     of the persons who are shown on the website. Writes nothing, except adding to the visit
//     counts.
//   - a member: someone who has signed in with a confirmed e-mail address that stands on
//     exactly one person in the register. Reads their own person, the people in their own
//     groups (name and phone; e-mail only when they lead the group), and the planning of
//     the gatherings they can open. Answers for themselves, and leads the groups they lead.
//   - a web editor (nettredaktør): a member whose person has that role. Writes the website: the
//     pages, the news, the talks, the media library, the website's settings and the history of
//     the pages; on an event only its picture, text, link and visibility. Nothing of the register,
//     the groups or the planning.
//   - an administrator: a member whose person is an administrator. Writes everything.
//
// Who someone is, is looked up in `logins` (see src/utils/logins.ts): one document per address,
// saying which person it is and whether the person is an administrator. Only an administrator
// writes there, and the app writes it from the register (src/hooks/useRegisterMirror.ts).
//
// The first administrator is put in from the outside, BEFORE these rules are published
// (scripts/first-admin.ts). With the rules in place and nobody in `logins`, nobody gets in.
//
// The demo has its own rules, firestore.demo.rules, which are open. They must never be
// published in a database with real persons.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who is asking ----------

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function loginPath() {
      return /databases/$(database)/documents/logins/$(request.auth.token.email.lower());
    }

    function isMember() {
      return signedIn() && exists(loginPath());
    }

    function isAdmin() {
      return signedIn() && get(loginPath()).data.role == 'admin';
    }

    function isWebEditor() {
      return signedIn() && get(loginPath()).data.role == 'nettredaktor';
    }

    function isMembershipClerk() {
      return isMember()
        && get(/databases/$(database)/documents/persons/$(me())).data.get('membershipClerk', false) == true;
    }

    // Who writes the website: an administrator, and a web editor
    function writesWebsite() {
      return isAdmin() || isWebEditor();
    }

    // The person in the register the one who asks is. Only called where isMember() holds.
    function me() {
      return get(loginPath()).data.personId;
    }

    function leadsThis(group) {
      return me() in group.leaderIds || me() in group.get('deputyLeaderIds', []);
    }

    // Whether the one who asks is leader or deputy leader of the group
    function leads(groupId) {
      return isMember()
        && groupId is string
        && leadsThis(get(/databases/$(database)/documents/groups/$(groupId)).data);
    }

    function readerId(gatheringId) {
      return gatheringId + '_' + me();
    }

    function readerOf(gatheringId) {
      return exists(/databases/$(database)/documents/gatheringReaders/$(readerId(gatheringId)));
    }

    // Membership is read from the group document, which is what an administrator edits.
    // A directory card that has not yet been removed does not keep anyone in.
    function holdsPlace(group, personId) {
      return personId in group.get('memberIds', [])
        || personId in group.get('leaderIds', [])
        || personId in group.get('deputyLeaderIds', []);
    }

    function inGroupData(group) {
      return holdsPlace(group, me());
    }

    function memberOf(groupId) {
      return groupId is string
        && holdsPlace(get(/databases/$(database)/documents/groups/$(groupId)).data, me());
    }

    function personIn(groupId, personId) {
      return groupId is string
        && personId is string
        && holdsPlace(get(/databases/$(database)/documents/groups/$(groupId)).data, personId);
    }

    // Everyone already in the group, in any of the three lists.
    function groupPeople(group) {
      return group.get('memberIds', [])
        .concat(group.get('leaderIds', []))
        .concat(group.get('deputyLeaderIds', []));
    }

    // A leader may change the group, but not bring in someone who is not already in it,
    // and not add anyone to the leader or deputy lists. Removing someone still works.
    function staysInside(group) {
      let people = groupPeople(group);
      return people.hasAll(request.resource.data.get('memberIds', []))
        && group.get('leaderIds', []).hasAll(request.resource.data.get('leaderIds', []))
        && group.get('deputyLeaderIds', []).hasAll(request.resource.data.get('deputyLeaderIds', []));
    }

    // A leader or deputy of the task's group, the gathering's group, or the group the name was taken from.
    function tendsAssignment() {
      return leads(resource.data.gatheringGroupId)
        || leads(resource.data.get('nameGroupId', null))
        || (resource.data.taskId is string
            && leads(get(/databases/$(database)/documents/tasks/$(resource.data.taskId)).data.get('groupId', null)));
    }

    // Whether the one who asks leads the group the event belongs to
    function leadsEvent(gatheringId) {
      return gatheringId is string
        && leads(get(/databases/$(database)/documents/gatherings/$(gatheringId)).data.groupId);
    }

    // A role that leads the gathering. The same list as PROGRAM_EDITOR_ROLES in src/utils/programEditor.ts.
    function leadsGatheringRole(task) {
      return task.get('volunteerRoleId', null) is string
        ? get(/databases/$(database)/documents/cms_settings/$(task.volunteerRoleId)).data.get('name', '') in ['Møteleder', 'Gudstjenesteleder']
        : task.get('title', '') in ['Møteleder', 'Gudstjenesteleder'];
    }

    // The one who has said yes to leading this gathering. The assignment named in the write must be theirs,
    // confirmed, on a task of this gathering that is not cancelled.
    function editsProgramOf(gatheringId) {
      let by = request.resource.data.programEditedBy;
      let a = get(/databases/$(database)/documents/assignments/$(by.assignmentId)).data;
      let t = get(/databases/$(database)/documents/tasks/$(a.taskId)).data;
      return isMember()
        && by.personId == me()
        && a.personId == me()
        && a.response == 'confirmed'
        && t.gatheringId == gatheringId
        && t.get('status', '') != 'cancelled'
        && leadsGatheringRole(t);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- Givertjeneste: who may see givers and gifts ----------
    //
    // No role gives this, administrator included. Each right is given to one person, in
    // givingAccess/<address>, and counts only while ALL of this holds: the person is in the
    // register under that address, is signed in with Google in this session, with the Google
    // account the right was taken into use with, and the module is on. Google keeps out the
    // sign-in links sent by e-mail; the stored Google id keeps out another Google account that
    // someone has tied to the same user.

    function signedInWithGoogle() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function givingAccessPath(address) {
      return /databases/$(database)/documents/givingAccess/$(address);
    }

    function myGivingAccess() {
      return get(givingAccessPath(request.auth.token.email.lower())).data;
    }

    function givingOn() {
      return get(/databases/$(database)/documents/cms_settings/addons).data.get('on', {}).get('givertjeneste', false) == true;
    }

    function givingMay(right) {
      return signedInWithGoogle()
        && isMember()
        && exists(givingAccessPath(request.auth.token.email.lower()))
        && myGivingAccess().personId == me()
        && myGivingAccess().get('googleId', '') in request.auth.token.firebase.identities.get('google.com', [])
        && myGivingAccess().get(right, false) == true
        && givingOn();
    }

    // Givers, agreements and gifts carry who made them and when, and a version that counts up
    function isStamped(data) {
      return data.keys().hasAll(['version', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && data.version is int
        && data.createdAt is string
        && data.createdBy is string
        && data.updatedAt is string
        && data.updatedBy == me();
    }

    function isFirstVersion() {
      return request.resource.data.version == 1 && request.resource.data.createdBy == me();
    }

    function isNextVersion() {
      return request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    // The change is written in the history in the same sending: a new entry, holding what the document became
    function historyEntry(kind, docId) {
      return /databases/$(database)/documents/givingEvents/$(kind + '_' + docId + '_' + string(request.resource.data.version));
    }

    function keepsHistory(kind, docId) {
      return !exists(historyEntry(kind, docId))
        && getAfter(historyEntry(kind, docId)).data.data == request.resource.data;
    }

    function isDay(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------- Beside the register ----------

    // The app asks for this document to see whether the database answers
    match /test/{docId} {
      allow get: if true;
    }

    // Who may sign in. Someone signing in reads their own, to learn which person they are.
    match /logins/{address} {
      // The one with «Tilganger» in givertjeneste looks up one address, to know which person it is
      allow get: if (signedIn() && request.auth.token.email.lower() == address) || isAdmin() || givingMay('manage');
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // The log of requests for a sign-in link (server/signInEmail.ts). The installation's functions
    // write it with the service account, which these rules do not stop; only an administrator reads it.
    match /loginRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // What the website shows of persons: public fields only
    match /publicProfiles/{personId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- The register and the planning ----------

    match /persons/{personId} {
      // The one with «Givere» reads the register to tie a giver to a person
      allow get: if isAdmin() || isMembershipClerk() || (isMember() && personId == me()) || givingMay('individual');
      allow list: if isAdmin() || isMembershipClerk() || givingMay('individual');
      allow create, delete: if isAdmin();
      // A member changes nothing about themselves but how their own analysis board is laid out,
      // and the key to their own calendar subscription (src/services/personalCalendarFeed.ts)
      allow update: if isAdmin()
        || (isMembershipClerk()
            && changedOnly(['congregationMember', 'denominationMember', 'congregationJoinedAt', 'denominationJoinedAt', 'denominationEnrollmentType', 'denominationGEndedAt', 'congregationEndedAt', 'denominationEndedAt', 'membershipLog']))
        || (isMember() && personId == me() && changedOnly(['analyticsHiddenModules', 'calendarFeedToken', 'membershipLog']));
    }

    // Name and phone for the people in one group. A member reads only the groups they belong to.
    match /groupDirectory/{cardId} {
      allow get: if isAdmin() || (isMember() && memberOf(resource.data.groupId));
      allow list: if isAdmin() || (isMember() && memberOf(resource.data.groupId));
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['groupId', 'personId', 'name', 'phone'])
        && request.resource.data.keys().hasAll(['groupId', 'personId', 'name']);
      allow delete: if isAdmin();
    }

    // E-mail for the people in one group. Only a leader or deputy of that group, besides an administrator.
    match /groupLeaderEmails/{cardId} {
      allow get, list: if isAdmin() || leads(resource.data.groupId);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['groupId', 'personId', 'email'])
        && request.resource.data.keys().hasAll(['groupId', 'personId', 'email']);
      allow delete: if isAdmin();
    }

    // The website's copy of a public group, without the private member list.
    match /publicGroupCards/{groupId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'description', 'category', 'tags', 'meetingSchedule', 'isPublic', 'memberCount', 'leaderIds', 'deputyLeaderIds', 'memberIds'])
        && request.resource.data.isPublic == true
        && request.resource.data.memberCount is int;
      allow delete: if isAdmin();
    }

    // The mark that lets one person read the names on one gathering.
    match /gatheringReaders/{markId} {
      allow read: if isAdmin() || (isMember() && markId == readerId(resource.data.gatheringId));
      allow create: if isAdmin()
        || (isMember()
            && request.resource.data.personId == me()
            && markId == request.resource.data.gatheringId + '_' + me()
            && request.resource.data.keys().hasOnly(['gatheringId', 'personId']))
        || (isMember()
            && leads(request.resource.data.nameGroupId)
            && personIn(request.resource.data.nameGroupId, request.resource.data.personId)
            && markId == request.resource.data.gatheringId + '_' + request.resource.data.personId
            && request.resource.data.keys().hasOnly(['gatheringId', 'personId', 'nameGroupId']));
      allow update, delete: if isAdmin();
    }

    // Who has unsubscribed from the newsletter: a document named by the key in the link they
    // pressed, holding only when. Anyone with the link may add it, and see that it is there; only
    // an administrator may list them (and so tell whose key it is) or take one away again.
    match /newsletterOptOuts/{key} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if key.matches('^[A-Za-z0-9_-]{32}$')
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at is string
        && request.resource.data.at.size() <= 40;
    }

    // The e-mail lists made on the Personer tab (src/services/emailLists.ts): a saved filter, or the
    // persons on a fixed list. Only an administrator reads or writes them.
    match /emailLists/{listId} {
      allow read, write: if isAdmin();
    }

    // Givertjeneste: what a gift can be given to (src/services/giving/purposes.ts). Not personal
    // data. An administrator keeps the list. Nothing is ever deleted, and what a purpose is used
    // for (ordinary running or earmarked) stands as it was made, so old figures do not move.
    match /givingPurposes/{purposeId} {
      function validPurpose(data) {
        return data.keys().hasOnly(['name', 'usage', 'active', 'createdAt', 'updatedAt', 'updatedBy'])
          && data.keys().hasAll(['name', 'usage', 'active', 'createdAt', 'updatedAt', 'updatedBy'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 80
          && data.usage in ['drift', 'oremerket']
          && data.active is bool
          && data.createdAt is string && data.updatedAt is string
          && data.updatedBy == me();
      }
      allow read: if isAdmin() || givingMay('individual') || givingMay('overview') || givingMay('budget');
      allow create: if isAdmin() && validPurpose(request.resource.data);
      allow update: if isAdmin() && validPurpose(request.resource.data)
        && request.resource.data.usage == resource.data.usage
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // ---------- Givertjeneste: access, givers and gifts ----------

    // Who holds a right in givertjeneste. One document for each address that has been given one.
    // Never deleted: a right is taken away by setting it to false.
    match /givingAccess/{address} {
      // The one signed in with the address, whatever the way in, so the app can say what is missing
      function isOwnAddress() {
        return signedIn() && request.auth.token.email.lower() == address;
      }

      // Every change is written in the log in the same sending: a new entry, holding what the document became
      function logEntry() {
        return /databases/$(database)/documents/givingLog/$('access_' + address + '_' + string(request.resource.data.version));
      }

      function isLogged() {
        return !exists(logEntry()) && getAfter(logEntry()).data.access == request.resource.data;
      }

      function validAccess(data) {
        return data.keys().hasOnly(['personId', 'name', 'overview', 'budget', 'individual', 'manage', 'googleId', 'version', 'updatedAt', 'updatedBy'])
          && data.keys().hasAll(['personId', 'name', 'overview', 'budget', 'individual', 'manage', 'version', 'updatedAt', 'updatedBy'])
          && data.personId is string && data.personId.size() > 0
          && data.name is string && data.name.size() <= 120
          && data.overview is bool && data.budget is bool && data.individual is bool && data.manage is bool
          && data.version is int
          && data.updatedAt is string
          && data.updatedBy == me();
      }

      function hasNoRight(data) {
        return data.overview == false && data.budget == false && data.individual == false && data.manage == false;
      }

      // The address signs in as that person. Not asked for when every right is taken away, so that
      // can be done for someone who is no longer in the register.
      function addressIsThePerson() {
        return get(/databases/$(database)/documents/logins/$(address)).data.personId == request.resource.data.personId;
      }

      allow get: if isOwnAddress() || givingMay('manage');
      allow list: if givingMay('manage');

      // The holder of «Tilganger» gives rights to others: never under their own address, and never
      // to their own person under another one
      allow create: if givingMay('manage')
        && address != request.auth.token.email.lower()
        && address == address.lower()
        && validAccess(request.resource.data)
        && request.resource.data.version == 1
        && request.resource.data.personId != me()
        && !('googleId' in request.resource.data)
        && addressIsThePerson()
        && isLogged();

      allow update: if (givingMay('manage')
            && address != request.auth.token.email.lower()
            && validAccess(request.resource.data)
            && resource.data.personId != me()
            && request.resource.data.personId != me()
            && request.resource.data.version == resource.data.version + 1
            // The Google account is never chosen for someone: it stays with the same person, or is
            // taken away so the person takes the rights into use again
            && (!('googleId' in request.resource.data)
                || (request.resource.data.googleId == resource.data.get('googleId', '')
                    && request.resource.data.personId == resource.data.personId))
            && ((hasNoRight(request.resource.data) && request.resource.data.personId == resource.data.personId)
                || addressIsThePerson())
            && isLogged())
        // Taking the rights into use: the person themselves, signed in with Google, once
        || (isOwnAddress()
            && signedInWithGoogle()
            && isMember()
            && resource.data.personId == me()
            && !('googleId' in resource.data)
            && validAccess(request.resource.data)
            && changedOnly(['googleId', 'name', 'version', 'updatedAt', 'updatedBy'])
            && request.resource.data.googleId == request.auth.token.firebase.identities['google.com'][0]
            && request.resource.data.name == get(/databases/$(database)/documents/persons/$(me())).data.name
            && request.resource.data.version == resource.data.version + 1
            && isLogged());

      allow delete: if false;
    }

    // The log of who was given what. Written only beside the change itself, never changed or removed.
    match /givingLog/{entryId} {
      allow read: if givingMay('manage');
      allow create: if signedInWithGoogle()
        && isMember()
        && request.resource.data.keys().hasOnly(['action', 'target', 'version', 'at', 'by', 'access'])
        && request.resource.data.keys().hasAll(['action', 'target', 'version', 'at', 'by', 'access'])
        && request.resource.data.action in ['grant', 'change', 'activate']
        && request.resource.data.at == request.time
        && request.resource.data.by == me()
        && entryId == 'access_' + request.resource.data.target + '_' + string(request.resource.data.version)
        && request.resource.data.access.version == request.resource.data.version
        && getAfter(givingAccessPath(request.resource.data.target)).data == request.resource.data.access
        // The access document is really changed in this sending, which its own rule has to allow,
        // and the entry says which kind of change it was
        && (!exists(givingAccessPath(request.resource.data.target))
            ? request.resource.data.action == 'grant'
            : (get(givingAccessPath(request.resource.data.target)).data.version != request.resource.data.version
               && request.resource.data.action
                    == (('googleId' in request.resource.data.access
                          && !('googleId' in get(givingAccessPath(request.resource.data.target)).data))
                        ? 'activate' : 'change')));
      allow update, delete: if false;
    }

    // Who gives. A giver who is in the register has the person's id, so nobody is entered twice.
    match /givers/{giverId} {
      function validGiver(data) {
        return data.keys().hasOnly(['personId', 'name', 'email', 'phone', 'active', 'version', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && data.keys().hasAll(['name', 'active'])
          && isStamped(data)
          && data.name is string && data.name.size() > 0 && data.name.size() <= 120
          && data.active is bool
          // The contact details of someone in the register are there, and nowhere else
          && (!('personId' in data) || (data.personId is string && !('email' in data) && !('phone' in data)))
          && data.get('email', '') is string
          && data.get('phone', '') is string;
      }

      allow read: if givingMay('individual');
      allow create: if givingMay('individual')
        && validGiver(request.resource.data)
        && isFirstVersion()
        && (!('personId' in request.resource.data)
            || (request.resource.data.personId == giverId
                && exists(/databases/$(database)/documents/persons/$(giverId))))
        && keepsHistory('giver', giverId);
      // The tie to the register is made once, and then stands, also when the person is deleted there.
      // A giver tied to a person later keeps its id, but not when that person already is a giver.
      allow update: if givingMay('individual')
        && validGiver(request.resource.data)
        && isNextVersion()
        && (('personId' in resource.data)
            ? request.resource.data.get('personId', '') == resource.data.personId
            : (!('personId' in request.resource.data)
                || (exists(/databases/$(database)/documents/persons/$(request.resource.data.personId))
                    && !exists(/databases/$(database)/documents/givers/$(request.resource.data.personId)))))
        && keepsHistory('giver', giverId);
      allow delete: if false;
    }

    // What a giver has said they will give. An intention, not a payment agreement with anyone.
    match /giftAgreements/{agreementId} {
      function validAgreement(data) {
        return data.keys().hasOnly(['giverId', 'purposeId', 'amountOre', 'frequency', 'startDate', 'endDate', 'method', 'status', 'externalRef', 'version', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && data.keys().hasAll(['giverId', 'purposeId', 'amountOre', 'frequency', 'startDate', 'method', 'status'])
          && isStamped(data)
          && data.amountOre is int && data.amountOre > 0
          && data.frequency in ['maned', 'kvartal', 'ar']
          && isDay(data.startDate)
          && (!('endDate' in data) || (isDay(data.endDate) && data.endDate >= data.startDate))
          && data.method in ['vipps', 'bank', 'kontant', 'annet']
          && data.status in ['aktiv', 'pause', 'avsluttet']
          && data.get('externalRef', '') is string
          && existsAfter(/databases/$(database)/documents/givers/$(data.giverId))
          && exists(/databases/$(database)/documents/givingPurposes/$(data.purposeId));
      }

      allow read: if givingMay('individual');
      allow create: if givingMay('individual')
        && validAgreement(request.resource.data)
        && isFirstVersion()
        && keepsHistory('agreement', agreementId);
      allow update: if givingMay('individual')
        && validAgreement(request.resource.data)
        && isNextVersion()
        && request.resource.data.giverId == resource.data.giverId
        && keepsHistory('agreement', agreementId);
      allow delete: if false;
    }

    // Money received. Amounts are whole øre. Never deleted: a wrong gift is corrected, or marked as
    // cancelled with the reason, and then stands. An imported gift has the id of its transaction, so
    // the same transaction cannot be entered twice.
    match /gifts/{giftId} {
      function validGift(data) {
        return data.keys().hasOnly(['date', 'year', 'amountOre', 'purposeId', 'type', 'source', 'identification', 'giverId', 'agreementId', 'gatheringId', 'externalRef', 'settlementRef', 'payerText', 'importId', 'status', 'voidReason', 'version', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && data.keys().hasAll(['date', 'year', 'amountOre', 'purposeId', 'type', 'source', 'identification', 'status'])
          && isStamped(data)
          && isDay(data.date)
          && data.year is int && data.date.split('-')[0] == string(data.year)
          && data.amountOre is int && data.amountOre > 0
          && data.type in ['fast', 'enkeltgave', 'kollekt']
          && data.source in ['vipps', 'bank', 'kontant', 'annet']
          && data.identification in ['kjent', 'anonym', 'uidentifisert']
          // A gift has a giver exactly when the giver is known
          && (data.identification == 'kjent') == ('giverId' in data)
          && (!('giverId' in data) || existsAfter(/databases/$(database)/documents/givers/$(data.giverId)))
          && (!('agreementId' in data)
              || ('giverId' in data
                  && getAfter(/databases/$(database)/documents/giftAgreements/$(data.agreementId)).data.giverId == data.giverId))
          && data.get('gatheringId', '') is string
          && data.get('externalRef', '') is string
          && data.get('settlementRef', '') is string
          && data.get('payerText', '') is string
          && data.get('importId', '') is string
          && data.status in ['gyldig', 'annullert']
          && (data.status == 'annullert') == ('voidReason' in data)
          && (!('voidReason' in data) || (data.voidReason is string && data.voidReason.size() > 0))
          && exists(/databases/$(database)/documents/givingPurposes/$(data.purposeId));
      }

      allow read: if givingMay('individual');
      allow create: if givingMay('individual')
        && validGift(request.resource.data)
        && isFirstVersion()
        && request.resource.data.status == 'gyldig'
        && keepsHistory('gift', giftId);
      // Where it came from stands. A cancelled gift is not changed again.
      allow update: if givingMay('individual')
        && validGift(request.resource.data)
        && isNextVersion()
        && resource.data.status == 'gyldig'
        && request.resource.data.source == resource.data.source
        && request.resource.data.get('externalRef', '') == resource.data.get('externalRef', '')
        && request.resource.data.get('importId', '') == resource.data.get('importId', '')
        && keepsHistory('gift', giftId);
      allow delete: if false;
    }

    // The history of givers, agreements and gifts: one entry for every version, holding the document
    // as it became. Written only beside the change itself, never changed or removed.
    match /givingEvents/{entryId} {
      function changed() {
        let kind = request.resource.data.kind;
        let name = kind == 'giver' ? 'givers' : (kind == 'agreement' ? 'giftAgreements' : 'gifts');
        return /databases/$(database)/documents/$(name)/$(request.resource.data.docId);
      }

      allow read: if givingMay('individual');
      allow create: if givingMay('individual')
        && request.resource.data.keys().hasOnly(['kind', 'docId', 'version', 'at', 'by', 'data'])
        && request.resource.data.keys().hasAll(['kind', 'docId', 'version', 'at', 'by', 'data'])
        && request.resource.data.kind in ['giver', 'agreement', 'gift']
        && entryId == request.resource.data.kind + '_' + request.resource.data.docId + '_' + string(request.resource.data.version)
        && request.resource.data.data.version == request.resource.data.version
        && request.resource.data.at == request.time
        && request.resource.data.by == me()
        && getAfter(changed()).data == request.resource.data.data
        && (!exists(changed()) || get(changed()).data.version != request.resource.data.version);
      allow update, delete: if false;
    }

    match /groups/{groupId} {
      allow read: if isAdmin() || (isMember() && inGroupData(resource.data));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isMember() && leadsThis(resource.data) && staysInside(resource.data))
        // A member turns their own notifications from the group on or off
        || (isMember()
            && changedOnly(['notificationPreferences'])
            && request.resource.data.notificationPreferences
                 .diff(resource.data.get('notificationPreferences', {}))
                 .affectedKeys().hasOnly([me()]));
    }

    match /gatherings/{gatheringId} {
      allow read: if resource.data.isPublic == true || isMember();
      allow create: if isAdmin() || leads(request.resource.data.groupId);
      // A leader cannot move an event to a group they do not lead
      allow update: if isAdmin()
        || (leads(resource.data.groupId) && request.resource.data.groupId == resource.data.groupId)
        // A web editor gives the event its picture and text on the website, and nothing else
        || (isWebEditor() && changedOnly(['imageUrl', 'imageAlt', 'imageFocus', 'summary', 'content', 'linkUrl', 'linkLabel', 'visibility', 'isPublic']))
        // The meeting leader changes the programme of their own gathering, and nothing else
        || (changedOnly(['programSchedule', 'programEditedBy', 'programEditedAt'])
            && request.resource.data.programEditedBy is map
            && request.resource.data.programEditedBy.keys().hasOnly(['assignmentId', 'personId', 'personName'])
            && editsProgramOf(gatheringId));
      allow delete: if isAdmin() || leads(resource.data.groupId);
    }

    match /tasks/{taskId} {
      allow read: if isMember();
      allow create: if isAdmin()
        || leads(request.resource.data.get('groupId', null))
        || leadsEvent(request.resource.data.gatheringId);
      // The status follows from who has answered, and is written together with the answer.
      // A member may not cancel a task, or change one that is already cancelled.
      allow update: if isAdmin()
        || (isMember()
            && changedOnly(['status'])
            && resource.data.status != 'cancelled'
            && request.resource.data.status != 'cancelled')
        || leads(resource.data.get('groupId', null))
        || leadsEvent(resource.data.gatheringId)
        // A task of a role several teams share («Ikke fordelt»): a leader or member of one of them
        // takes it for their team. Only the team is written, and only to one of the teams it may go to.
        || (isMember()
            && resource.data.get('groupId', null) == null
            && changedOnly(['groupId'])
            && request.resource.data.groupId in resource.data.get('teamChoices', [])
            && (memberOf(request.resource.data.groupId) || leads(request.resource.data.groupId)));
      allow delete: if isAdmin()
        || leads(resource.data.get('groupId', null))
        || leadsEvent(resource.data.gatheringId);
    }

    // Who is asked, and what they answered. The name is stored here so the run sheet does not
    // open the register. A member reads their own, a public gathering, their own groups'
    // gatherings, and a gathering they have been marked to read.
    match /assignments/{assignmentId} {
      allow read: if isAdmin()
        || (isMember() && resource.data.personId == me())
        || (isMember() && resource.data.gatheringPublic == true)
        || (isMember() && memberOf(resource.data.gatheringGroupId))
        || (isMember() && readerOf(resource.data.gatheringId));

      allow create: if (isAdmin() && !('withdrawalReason' in request.resource.data))
        || (isMember()
            && request.resource.data.personId == me()
            && request.resource.data.personName == get(/databases/$(database)/documents/persons/$(me())).data.name
            && request.resource.data.keys().hasOnly(['taskId', 'personId', 'personName', 'gatheringId', 'gatheringGroupId', 'gatheringPublic', 'response', 'assignedAt']))
        || (isMember()
            && leads(request.resource.data.nameGroupId)
            && personIn(request.resource.data.nameGroupId, request.resource.data.personId)
            && request.resource.data.personName == get(/databases/$(database)/documents/groupDirectory/$(request.resource.data.nameGroupId + '_' + request.resource.data.personId)).data.name
            && request.resource.data.keys().hasOnly(['taskId', 'personId', 'personName', 'gatheringId', 'gatheringGroupId', 'gatheringPublic', 'nameGroupId', 'response', 'assignedAt']));

      // A reason is not stored. An administrator may remove one that is already there.
      allow update: if (isAdmin() && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['withdrawalReason'])
            || !('withdrawalReason' in request.resource.data)))
        || (isMember() && resource.data.personId == me() && changedOnly(['response', 'respondedAt']))
        || (tendsAssignment() && changedOnly(['response', 'respondedAt']));
      allow delete: if isAdmin() || tendsAssignment();
    }

    // A name a leader asks an administrator to add. No phone, e-mail or person id.
    // Confidential membership forms from Min side (see utils/membershipApplication.ts).
    match /membershipApplications/{applicationId} {
      allow get: if isAdmin() || isMembershipClerk()
        || (isMember() && resource.data.personId == me());
      allow list: if isAdmin() || isMembershipClerk()
        || (isMember() && resource.data.personId == me());
      allow create: if isMember()
        && request.resource.data.personId == me()
        && request.resource.data.status == 'submitted'
        && request.resource.data.submittedAt is string
        && request.resource.data.kind in ['congregationApply', 'denominationAdultEnroll', 'denominationChildEnroll', 'denominationGToA']
        && request.resource.data.lastName is string
        && request.resource.data.firstNames is string
        && request.resource.data.notOtherDenomination is bool;
      allow update: if isAdmin()
        || (isMembershipClerk()
            && changedOnly(['status', 'receivedAt', 'receivedBy', 'cornerstoneAt', 'cornerstoneBy', 'completedAt', 'completedBy', 'dismissedAt', 'dismissedBy', 'transitionGEndedAt', 'transitionAStartedAt']));
      allow delete: if isAdmin();
    }

    match /membershipClerkTasks/{taskId} {
      allow get, list: if isAdmin() || isMembershipClerk();
      allow create: if isAdmin() || isMembershipClerk();
      allow update: if isAdmin()
        || (isMembershipClerk()
            && changedOnly(['status', 'comment', 'doneAt', 'doneBy', 'correctedEnrollmentDate', 'instruction', 'cornerstoneUpdated', 'applicationArchiveConfirmed', 'attestationSent', 'attestationPosted', 'attestationEmailedAt', 'attestationEmailedBy']));
      allow delete: if isAdmin();
    }

    match /memberProposals/{proposalId} {
      allow get, list: if isAdmin() || leads(resource.data.groupId);
      allow create: if leads(request.resource.data.groupId)
        && request.resource.data.proposedBy == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.proposedAt is string
        && request.resource.data.keys().hasOnly(['groupId', 'name', 'proposedBy', 'proposedAt', 'status']);
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['added', 'dismissed']
        && request.resource.data.decidedAt is string
        && changedOnly(['status', 'decidedAt']);
      allow delete: if isAdmin()
        || (leads(resource.data.groupId)
            && resource.data.proposedBy == me()
            && resource.data.status == 'pending');
    }

    match /groupMessages/{messageId} {
      allow read: if isAdmin() || (isMember() && memberOf(resource.data.groupId));
      // Only into a group the sender is in (an administrator writes to any group)
      allow create: if isMember()
        && request.resource.data.senderPersonId == me()
        && (isAdmin() || memberOf(request.resource.data.groupId));
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isMember() && resource.data.senderPersonId == me())
        || leads(resource.data.groupId);
    }

    // Whether someone is coming to an event. Each answers for themselves.
    // A member reads their own answers, and the answers for a gathering of a group they belong to.
    match /gatheringAttendances/{attendanceId} {
      allow read: if isAdmin()
        || (isMember() && resource.data.personId == me())
        || (isMember() && memberOf(get(/databases/$(database)/documents/gatherings/$(resource.data.gatheringId)).data.groupId));
      allow create: if isAdmin() || (isMember() && request.resource.data.personId == me());
      // Someone else's answer cannot be taken over by writing one's own id into it
      allow update: if isAdmin()
        || (isMember() && resource.data.personId == me() && request.resource.data.personId == me());
      allow delete: if isAdmin() || (isMember() && resource.data.personId == me());
    }

    // Not in use: the headcounts and the roles are stored in cms_settings (see below)
    match /gatheringHeadcounts/{headcountId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /volunteer_roles/{roleId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ---------- The website ----------

    // A page that is not published is read by those in the register only
    match /cms_pages/{pageId} {
      allow read: if resource.data.isPublished == true || isMember();
      allow write: if writesWebsite();
    }

    match /cms_news/{articleId} {
      allow read: if true;
      allow write: if writesWebsite();
    }

    match /cms_sermons/{sermonId} {
      allow read: if true;
      allow write: if writesWebsite();
    }

    match /cms_staff/{staffId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // What is known of each file in the media library (the files are in Storage, see storage.rules)
    match /cms_media/{mediaId} {
      allow read: if true;
      allow write: if writesWebsite();
    }

    // The settings, and the marked documents that are stored beside them: the roles, the
    // headcounts, the templates, the semester plans and the answers to them, the visit counts,
    // the add-ons and the operating mode
    // (see src/data/settingsRecords.ts).
    match /cms_settings/{docId} {
      function isTrafficDay(data) {
        return docId.matches('^traffic-[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.recordType == 'siteTraffic'
          && data.keys().hasOnly(['recordType', 'date', 'views', 'hours', 'visits', 'entries', 'deepVisits', 'seconds', 'missing', 'actions', 'sermons']);
      }

      // One person's way through a semester plan (see src/utils/semesterPlan.ts): the person writes
      // their own, under the id made of the plan and themselves, and nothing else in it
      function isOwnSemesterAnswer(data) {
        return isMember()
          && data.recordType == 'semesterAnswer'
          && data.personId == me()
          && data.planId is string
          && docId == 'semester-answer-' + data.planId + '-' + me()
          && data.keys().hasOnly(['recordType', 'planId', 'personId', 'passed', 'declined', 'finishedAt', 'round', 'updatedAt']);
      }

      // The website reads the settings, which add-ons are on and the operating mode, and the
      // inbox of everyone a newsletter goes to fetches its banner (server/newsletterBanner.ts)
      allow get: if docId in ['global', 'addons', 'operating-mode', 'surfaces', 'newsletter-banner'] || isMember();
      allow list: if isMember();

      allow create: if isAdmin()
        // A web editor writes the website's settings, and the versions kept of pages and news
        || (isWebEditor() && (docId == 'global' || request.resource.data.recordType == 'contentVersion'))
        // A headcount, under the name a headcount has, so no other setting can be taken by it
        || (isMember() && request.resource.data.recordType == 'gatheringHeadcount' && docId.matches('^headcount-.+'))
        || isOwnSemesterAnswer(request.resource.data)
        // A visit to the website adds to the sums of the day
        || isTrafficDay(request.resource.data);
      allow update: if isAdmin()
        || (isWebEditor()
            && (docId == 'global'
                || (resource.data.recordType == 'contentVersion' && request.resource.data.recordType == 'contentVersion')))
        || (isMember()
            && resource.data.recordType == 'gatheringHeadcount'
            && request.resource.data.recordType == 'gatheringHeadcount')
        || (isMember()
            && resource.data.recordType == 'semesterAnswer'
            && resource.data.personId == me()
            && isOwnSemesterAnswer(request.resource.data))
        || (resource.data.recordType == 'siteTraffic' && isTrafficDay(request.resource.data));
      // The oldest versions beyond the thirty kept are removed by whoever saves
      allow delete: if isAdmin() || (isWebEditor() && resource.data.recordType == 'contentVersion');
    }
  }
}
